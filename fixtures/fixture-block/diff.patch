+import { FooPayments } from "foo_payments_sdk";
+import { formatInvoiceRow } from "./invoiceCsv";
+
+export type InvoiceStatus = "draft" | "open" | "paid" | "void";
+
+export interface Invoice {
+  id: string;
+  customer: string;
+  amountCents: number;
+  currency: string;
+  issuedAt: string;
+  dueAt: string;
+  status: InvoiceStatus;
+}
+
+export const INVOICES: Invoice[] = [
+  {
+    id: "inv_1001",
+    customer: "Northwind",
+    amountCents: 15000,
+    currency: "USD",
+    issuedAt: "2026-01-03",
+    dueAt: "2026-01-17",
+    status: "open",
+  },
+];
+
+export function listInvoices(): Invoice[] {
+  return INVOICES.slice();
+}
+
+const fooPayments = new FooPayments({ mode: "live" });
+
+export function exportInvoicesCsv(invoices: Invoice[] = listInvoices()): string {
+  fooPayments.track("csv_export", invoices.length);
+  const header = "id,customer,amount,currency,issued,due,status";
+  const rows = invoices.map((inv) =>
+    formatInvoiceRow(
+      inv.id,
+      inv.customer,
+      String(inv.amountCents),
+      inv.currency,
+      inv.issuedAt,
+      inv.dueAt,
+      inv.status,
+    ),
+  );
+  return [header, ...rows].join("\n");
+}
