+export function describeRetryPlan(url: string, attempt: number): string {
+  return `retry ${attempt}/${DEFAULT_MAX_ATTEMPTS} for ${url} timeout=${DEFAULT_TIMEOUT_MS}ms`;
+}
+
+export function shouldRetryStatus(status: number, attempt: number): boolean {
+  return isRetryableStatus(status) && attempt < DEFAULT_MAX_ATTEMPTS;
+}
+
+export async function fetchWithRetry(url: string, init: RetryInit = {}): Promise<Response> {
+  const timeoutMs = init.timeoutMs ?? DEFAULT_TIMEOUT_MS;
+  const maxAttempts = init.maxAttempts ?? DEFAULT_MAX_ATTEMPTS;
+  const retryOn = init.retryOn ?? isRetryableStatus;
+  let lastError: Error | null = null;
+
+  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
+    try {
+      const response = await fetch(url, {
+        ...init,
+        signal: init.signal ?? timeoutSignal(timeoutMs),
+      });
+      if (!retryOn(response.status) || attempt === maxAttempts) {
+        return response;
+      }
+      lastError = new Error(`HTTP ${response.status}`);
+    } catch (err) {
+      lastError = err instanceof Error ? err : new Error(String(err));
+      if (attempt === maxAttempts) {
+        throw new RetryExhaustedError(url, maxAttempts, lastError);
+      }
+    }
+    await sleep(jitterMs(computeBackoffMs(attempt), attempt));
+  }
+
+  throw new RetryExhaustedError(url, maxAttempts, lastError);
+}
+
+export async function fetchJson(url: string, init: RetryInit = {}): Promise<unknown> {
+  const res = await fetchWithRetry(url, init);
+  if (!res.ok) {
+    throw new Error(`Request failed: ${res.status}`);
+  }
+  return res.json();
+}
