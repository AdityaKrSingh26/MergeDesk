+import { abs } from "./math";
+
+/**
+ * Clamp `n` to the closed interval [min, max].
+ */
+export function clamp(n: number, min: number, max: number): number {
+  if (min > max) {
+    throw new RangeError("clamp(): min must be <= max");
+  }
+  if (Number.isNaN(n) || Number.isNaN(min) || Number.isNaN(max)) {
+    return Number.NaN;
+  }
+  if (n < min) return min;
+  if (n > max) return max;
+  return n;
+}
+
+export function clamp01(n: number): number {
+  return clamp(n, 0, 1);
+}
+
+export function clampUnit(n: number): number {
+  return clamp(n, -1, 1);
+}
+
+export function clampMagnitude(n: number, limit: number): number {
+  const bound = abs(limit);
+  return clamp(n, -bound, bound);
+}
+
+export function clampInt(n: number, min: number, max: number): number {
+  return clamp(Math.round(n), Math.ceil(min), Math.floor(max));
+}
+
+export function clampNonNegative(n: number): number {
+  return clamp(n, 0, Number.POSITIVE_INFINITY);
+}
+
+export function clampByte(n: number): number {
+  return clampInt(n, 0, 255);
+}
+
+export function clampPercent(n: number): number {
+  return clamp(n, 0, 100);
+}
+
+export function clampDegrees(n: number): number {
+  return clamp(n, 0, 360);
+}
+
+export function clampLatitude(n: number): number {
+  return clamp(n, -90, 90);
+}
+
+export function clampLongitude(n: number): number {
+  return clamp(n, -180, 180);
+}
diff --git a/src/clamp.test.ts b/src/clamp.test.ts
new file mode 100644
--- /dev/null
+++ b/src/clamp.test.ts
@@ -0,0 +1,89 @@
+import {
+  clamp,
+  clamp01,
+  clampByte,
+  clampDegrees,
+  clampInt,
+  clampLatitude,
+  clampLongitude,
+  clampMagnitude,
+  clampNonNegative,
+  clampPercent,
+  clampUnit,
+} from "./clamp";
+
+function assertEqual(actual: number, expected: number, name: string): void {
+  if (Object.is(actual, expected)) return;
+  throw new Error(`${name}: expected ${expected}, got ${actual}`);
+}
+
+assertEqual(clamp(5, 0, 10), 5, "inside");
+assertEqual(clamp(-2, 0, 10), 0, "below");
+assertEqual(clamp(99, 0, 10), 10, "above");
+assertEqual(clamp(0, 0, 10), 0, "min edge");
+assertEqual(clamp(10, 0, 10), 10, "max edge");
+assertEqual(clamp(-3, -10, -1), -3, "negative range inside");
+assertEqual(clamp(-40, -10, -1), -10, "negative range below");
+assertEqual(clamp(0, -10, -1), -1, "negative range above");
+assertEqual(clamp01(-0.2), 0, "clamp01 below");
+assertEqual(clamp01(0.4), 0.4, "clamp01 inside");
+assertEqual(clamp01(1.7), 1, "clamp01 above");
+assertEqual(clampUnit(-4), -1, "clampUnit below");
+assertEqual(clampUnit(0.2), 0.2, "clampUnit inside");
+assertEqual(clampUnit(8), 1, "clampUnit above");
+assertEqual(clampMagnitude(12, 5), 5, "magnitude positive");
+assertEqual(clampMagnitude(-12, 5), -5, "magnitude negative");
+assertEqual(clampMagnitude(1, 5), 1, "magnitude inside");
+assertEqual(clampInt(2.6, 0, 2), 2, "int rounds then clamps");
+assertEqual(clampInt(-3.2, 0, 4), 0, "int below");
+assertEqual(clampInt(9.1, 0, 4), 4, "int above");
+assertEqual(clamp(3, 3, 3), 3, "zero width");
+assertEqual(clamp(0.25, 0.1, 0.3), 0.25, "floats");
+assertEqual(clamp(0.01, 0.1, 0.3), 0.1, "floats below");
+assertEqual(clamp(0.9, 0.1, 0.3), 0.3, "floats above");
+assertEqual(clamp(1, 0, 8), 1, "mid 1");
+assertEqual(clamp(2, 0, 8), 2, "mid 2");
+assertEqual(clamp(3, 0, 8), 3, "mid 3");
+assertEqual(clamp(4, 0, 8), 4, "mid 4");
+assertEqual(clamp(5, 0, 8), 5, "mid 5");
+assertEqual(clamp(6, 0, 8), 6, "mid 6");
+assertEqual(clamp(7, 0, 8), 7, "mid 7");
+assertEqual(clamp(-1, 0, 8), 0, "lo 1");
+assertEqual(clamp(-2, 0, 8), 0, "lo 2");
+assertEqual(clamp(9, 0, 8), 8, "hi 9");
+assertEqual(clamp(10, 0, 8), 8, "hi 10");
+assertEqual(clamp(11, 0, 8), 8, "hi 11");
+assertEqual(clampMagnitude(0, 3), 0, "mag 0");
+assertEqual(clampMagnitude(3, 3), 3, "mag 3");
+assertEqual(clampMagnitude(4, 3), 3, "mag 4");
+assertEqual(clampMagnitude(-3, 3), -3, "mag -3");
+assertEqual(clampMagnitude(-4, 3), -3, "mag -4");
+assertEqual(clampUnit(0), 0, "unit 0");
+assertEqual(clampUnit(-1), -1, "unit -1");
+assertEqual(clampUnit(1), 1, "unit 1");
+assertEqual(clamp01(0), 0, "01 0");
+assertEqual(clamp01(1), 1, "01 1");
+assertEqual(clampNonNegative(4), 4, "nn 4");
+assertEqual(clampNonNegative(-1), 0, "nn -1");
+assertEqual(clampByte(128), 128, "byte 128");
+assertEqual(clampByte(-1), 0, "byte -1");
+assertEqual(clampByte(300), 255, "byte 300");
+assertEqual(clampPercent(40), 40, "pct 40");
+assertEqual(clampPercent(-5), 0, "pct -5");
+assertEqual(clampPercent(140), 100, "pct 140");
+assertEqual(clampDegrees(90), 90, "deg 90");
+assertEqual(clampDegrees(-10), 0, "deg -10");
+assertEqual(clampDegrees(400), 360, "deg 400");
+assertEqual(clampLatitude(45), 45, "lat 45");
+assertEqual(clampLatitude(-91), -90, "lat -91");
+assertEqual(clampLatitude(91), 90, "lat 91");
+assertEqual(clampLongitude(10), 10, "lon 10");
+assertEqual(clampLongitude(-181), -180, "lon -181");
+assertEqual(clampLongitude(181), 180, "lon 181");
+
+try {
+  clamp(1, 5, 2);
+  throw new Error("expected RangeError when min > max");
+} catch (err) {
+  if (!(err instanceof RangeError)) throw err;
+}
